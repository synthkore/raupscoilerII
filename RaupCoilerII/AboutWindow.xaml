<Window x:Class="RaupCoilerII.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="About ..." Height="625" Width="580"
        MinHeight="535" MinWidth="580"
        MaxHeight="885" MaxWidth="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="CanMinimize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,4,0"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="69*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>
        <!-- Definición de filas equivalente al TableLayoutPanel -->
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <!-- Filas para textos fijos -->
            <RowDefinition Height="22"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="22"/>
            <!-- Fila para el navegador web (toma el espacio restante) -->
            <RowDefinition Height="*"/>
            <!-- Fila para el botón inferior -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- 0. Panel con el Logo -->
        <Border Grid.Row="0" Margin="3,3,3,3" Background="Transparent" Grid.ColumnSpan="2">
            <Image x:Name="picBoxLogo"
             Source="/RaupCoilerII;component/Resources/logomini.png"
             Stretch="Uniform"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             MaxWidth="550" MaxHeight="265"
             MinHeight="201" MinWidth="459"/>
        </Border>

        <!-- Product name -->
        <TextBlock x:Name="lblProductName" Grid.Row="1" Text="Nombre de producto" Grid.ColumnSpan="2" Margin="7,0,4,0" />

        <!-- Version -->
        <TextBlock x:Name="lblVersion" Grid.Row="2" Text="Versión" Grid.ColumnSpan="2" Margin="7,0,4,0" />

        <!-- Build Date -->
        <TextBlock x:Name="lblBuild" Grid.Row="3" Text="Build date" Margin="7,0,4,0" Grid.ColumnSpan="2"/>

        <!-- Link to license conditions -->
        <TextBlock x:Name="licenseLbl" Grid.Row="4" Margin="7,0,4,0" Grid.ColumnSpan="2">
          <Hyperlink x:Name="lnkLblLicense" NavigateUri="https://www.tolaemon.com/raupcoilerii/index.htm#license" RequestNavigate="lnkLblLicense_RequestNavigate">
          
          <Hyperlink.Style>             
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="Green"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="DarkGreen"/>
                    </Trigger>
                </Style.Triggers>
            </Style>             
          </Hyperlink.Style>             
              
            RaupCoilerII license
          </Hyperlink>
        </TextBlock>

        <!-- Web browser container-->
        <Grid x:Name="webContainer" Grid.Row="5" Margin="3,3,3,3" Grid.ColumnSpan="2"/>

        <!-- Accept button -->
        <Button x:Name="btnAccept" Grid.Row="6" Content="Accept" 
            Width="118" Height="28" 
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Click="BtnAccept_Click" Grid.Column="1"/>

    </Grid>
</Window>