<Window x:Class="RaupCoilerII.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:local="clr-namespace:RaupCoilerII"
        mc:Ignorable="d"
        Title="Raup Coiler II" Height="745" Width="1105" MinWidth="1055" MinHeight="650">
    <Window.Resources>
        <Style x:Key="VerticalCenteredTextBox"
               TargetType="TextBox">
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
        <local:stringToFloatConverter  x:Key="stringToFloatConverter"/>
        <local:stringToDoubleConverter  x:Key="stringToDoubleConverter"/>
        <local:doubleToIntConverter  x:Key="doubleToIntConverter"/>
        <local:colorToBrushConverter x:Key="colorToBrushConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="220*"/>
        </Grid.ColumnDefinitions>
        <Menu Height="40" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <MenuItem Header="File">
                <MenuItem Header="New">
                </MenuItem>
                <MenuItem Header="Load">
                </MenuItem>
                <MenuItem Header="Save">
                </MenuItem>
                <MenuItem Header="Export" Click="menuExportItem_Click">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Online help">
                </MenuItem>
                <MenuItem Header="About">
                </MenuItem>
            </MenuItem>
        </Menu>
        <!-- Main Layout Grid: column 0: OpenGL control, column 1: hide button, column 2: parameters editor -->
        <Grid Background="#FFE5E5E5" Margin="0,20,0,0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <!-- Column 0: left panel, the OpenGL WPF control used to render the model -->
                <ColumnDefinition x:Name="leftPanel" Width="*"/>
                <!-- Column 1: with the button used to hide or show the rirght panel as if it was a splitter -->
                <ColumnDefinition Width="7"/>
                <!-- Column 2: right panel, grid column wiht the controls used to enter the model parameters -->
                <ColumnDefinition x:Name="rigthPanel" Width="{x:Static local:ViewModel.rightPanelWidth}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <!-- Column 0: the OpenGL WPF control used to render the model -->
            <glWpfControl:GLWpfControl x:Name="OpenTkControl" Render="OpenTkControl_OnRender" Loaded="OpenTkControl_Loaded" SizeChanged="OpenTkControl_SizeChanged" MouseLeftButtonDown="OpenTkControl_MouseLeftButtonDown" MouseLeftButtonUp="OpenTkControl_MouseLeftButtonUp" MouseMove="OpenTkControl_MouseMove" MouseWheel="OpenTkControl_MouseWheel" />
            <!-- Column 1: with the button used to hide or show the rirght panel as if it was a splitter -->
            <Button Grid.Column="1" Click="PanelSplitButton_Click"/>
            <!-- Column 2: the column with the tools -->
            <TabControl Grid.Column="2" Margin="2,2,2,2">
                <!--BEGIN: ######################################################### Model TabPage control #########################################################-->
                <TabItem Header="Model" HorizontalAlignment="Right" Margin="0,-2,-2,0" Width="50">
                    <!--BEGIN: ############ Model TabPage main grid: 2 columns 1 row ############ -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!--BEGIN: ############ Model TabPage main grid Column 0: grid 1 column 2 rows  ############ -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="250"/>
                                <RowDefinition  Height="280"/>
                            </Grid.RowDefinitions>
                            <!-- BEGIN: ############ Model TabPage main grid Column 0: Column 0 -->
                            <!-- GroupBox Raup parameters panel -->
                            <GroupBox Header="Raup" Grid.Row="0" Margin="2,2,2,2" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="187*"/>
                                        <ColumnDefinition Width="42*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <!-- D parameter -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="0" Grid.ColumnSpan="2">
                                        <Label Content="D:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding Dparam, Mode=TwoWay, Converter={StaticResource stringToDoubleConverter},ConverterParameter=3}" Width="120" Style="{StaticResource VerticalCenteredTextBox}" />
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding Dparam, Mode=TwoWay}" Minimum="{x:Static local:ViewModel.DparamMin}" Maximum="{x:Static local:ViewModel.DparamMax}" ViewportSize="0.01" Orientation="Horizontal" Margin="2,2,0,2" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="0.025" LargeChange="0.1" />
                                    </WrapPanel>
                                    <!-- W parameter -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="1" Grid.ColumnSpan="2">
                                        <Label Content="W:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding Wparam, Mode=TwoWay, Converter={StaticResource stringToDoubleConverter},ConverterParameter=3}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding Wparam, Mode=TwoWay}" Minimum="{Binding WparamMin}" Maximum="{Binding WparamMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" LargeChange="5"/>
                                    </WrapPanel>
                                    <!-- T parameter -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="2" Grid.ColumnSpan="2">
                                        <Label Content="T:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding Tparam, Mode=TwoWay, Converter={StaticResource stringToDoubleConverter},ConverterParameter=3}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding Tparam, Mode=TwoWay}" Minimum="{Binding TparamMin}" Maximum="{Binding TparamMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="0.1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!-- S parameter -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="3" Grid.ColumnSpan="2">
                                        <Label Content="S:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding Sparam, Mode=TwoWay, Converter={StaticResource stringToDoubleConverter},ConverterParameter=3}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding Sparam, Mode=TwoWay}" Minimum="{Binding SparamMin}" Maximum="{Binding SparamMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="0.025" LargeChange="0.1"/>
                                    </WrapPanel>
                                </Grid>
                            </GroupBox>
                            <!-- END: ############ Model TabPage main grid Column 0: Column 0: Row 0 -->
                            <!-- BEGIN: ############ Model TabPage main grid Column 0: Column 0: Row 1 -->
                            <!-- GroupBox Mesh parameters panel -->
                            <GroupBox Header="Mesh" Grid.Column="0" Grid.Row="1" Margin="2,2,2,58" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="227*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <!-- Revolutions  -->
                                    <WrapPanel Margin="2,2,0,2" Grid.Row="0">
                                        <Label Content="Revolutions:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding Revolutions,Converter={StaticResource doubleToIntConverter}, Mode=TwoWay}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding Revolutions, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="{Binding RevolutionsMin}" Maximum="{Binding RevolutionsMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                        <!-- <ScrollBar Value="{Binding Revolutions, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="1" Maximum="16" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/> -->
                                    </WrapPanel>
                                    <!-- Resolution  -->
                                    <WrapPanel Margin="2,2,0,2" Grid.Row="1">
                                        <Label Content="Resolution:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding Resolution,Converter={StaticResource doubleToIntConverter}, Mode=TwoWay}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding Resolution, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="{Binding ResolutionMin}" Maximum="{Binding ResolutionMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!-- RingsRev  -->
                                    <WrapPanel Margin="2,2,0,2" Grid.Row="2">
                                        <Label Content="Rings/Rev:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding RingsRev, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding RingsRev, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="{Binding RingsRevMin}" Maximum="{Binding RingsRevMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!-- Shell width  -->
                                    <WrapPanel Margin="2,2,0,2" Grid.Row="3">
                                        <Label Content="Width(%):"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding ShellWidthPercent, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding ShellWidthPercent, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="1" Maximum="100" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>                                    
                                </Grid>
                            </GroupBox>
                            <!-- END: ############ Model TabPage main grid Column 0: Column 0: Row 0 -->
                        </Grid>
                        <!--END: ############ Model TabPage main grid: Column 0 Grid: 1 column 2 rows  ############ -->
                        <!--BEGIN: ############ Model TabPage main grid: Column 1 Grid: 1 column 2 rows  ############ -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="340"/>
                                <RowDefinition Height="330"/>
                            </Grid.RowDefinitions>
                            <!-- BEGIN: ############ Model TabPage main grid: Column 1: Row 0 -->
                            <!-- GroupBox Drawing options panel -->
                            <GroupBox Header="Drawing" Grid.Row="0" Margin="2,2,2,2" BorderBrush="Black" BorderThickness="1">
                                <StackPanel>
                                    <!-- BEGIN GroupBox: Shell mesh geometry options -->
                                    <GroupBox Header="Geometry" Margin="2,0,2,0" BorderBrush="Black" BorderThickness="1" Height="178" Width="220">
                                        <StackPanel Margin="10,10,10,10" >
                                            <RadioButton Name="radNoMesh" Content="No mesh" Height="24" VerticalAlignment="Top" IsChecked="{Binding NoMesh}"/>
                                            <RadioButton Name="radVertexs" Content="Vertexs" Height="24" VerticalAlignment="Top" IsChecked="{Binding Vertexs}"/>
                                            <RadioButton Name="radRings" Content="Rings" Height="24" VerticalAlignment="Top"  IsChecked="{Binding Rings}"/>
                                            <RadioButton Name="radQuads" Content="Quads" Height="24" VerticalAlignment="Top"  IsChecked="{Binding Quads}"/>
                                            <RadioButton Name="radTriangles" Content="Triangles" Height="24" VerticalAlignment="Top" IsChecked="{Binding Triangles}"/>
                                            <RadioButton Name="radFaces" Content="Faces" Height="24" VerticalAlignment="Top" IsChecked="{Binding Faces}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <!-- END GroupBox: Shell mesh geometry options -->
                                    <!-- BEGIN CheckBoxes Spiral, Axis, AUtoscale -->
                                    <CheckBox Content="Spiral" IsChecked="{Binding Spiral}" Margin="8,8,4,4" />
                                    <CheckBox Content="Shell axis" IsChecked="{Binding ShellAxis}" Margin="8,2,4,4"/>
                                    <CheckBox Content="ZYX gizmo" IsChecked="{Binding XYZGizmo}" Margin="8,2,4,4"/>
                                    <CheckBox Content="Autoscale" IsChecked="{Binding Autoscale}" Margin="8,2,4,4" />
                                    <CheckBox Content="UnitCube" IsChecked="{Binding UnitCube}" Margin="8,2,4,4" />
                                    <CheckBox Content="XZ plane" IsChecked="{Binding XZPlane}" Margin="8,2,4,4" />
                                    <!-- END CheckBoxes Spiral, Axis, AUtoscale -->
                                </StackPanel>
                            </GroupBox>
                            <!-- END: ############ Model TabPage main grid: Column 1: Row 0 ############ -->
                            <!-- BEGIN: ############ Model TabPage main grid: Column 1: Row 1 ############ -->
                            <!-- GroupBox Spiral options panel -->
                            <GroupBox Header="Spiral" Grid.Row="1" Margin="2,2,2,168" BorderBrush="Black" BorderThickness="1" IsEnabled="{Binding Spiral}">
                                <Grid Height="140">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition Height="35"/>
                                    </Grid.RowDefinitions>
                                    <!-- Resolution  -->
                                    <WrapPanel Margin="2,2,0,2" Grid.Row="0">
                                        <Label Content="Resolution:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding SpiralResolution,Converter={StaticResource doubleToIntConverter}, Mode=TwoWay}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding SpiralResolution, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="{Binding SpiralResolutionMin}" Maximum="{Binding SpiralResolutionMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!-- Shell width  -->
                                    <WrapPanel Margin="2,2,0,2" Grid.Row="1">
                                        <Label Content=" Width:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding SpiralWidth, Mode=TwoWay, Converter={StaticResource stringToDoubleConverter},ConverterParameter=3}" IsEnabled="{Binding ExpandSpiral, Converter={StaticResource InverseBoolConverter}}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding SpiralWidth, Mode=TwoWay}" Minimum="0.1" Maximum="10.0" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="0.1" LargeChange="0.5"/>

                                    </WrapPanel>
                                    <!-- Revolutions  -->
                                    <WrapPanel Margin="2,0,2,2" Grid.Row="2">
                                        <CheckBox Content="Expand spiral to shell width" IsChecked="{Binding ExpandSpiral}" Margin="8,8,4,4" />
                                    </WrapPanel>                                    
                                </Grid>
                            </GroupBox>
                            <!-- END: ############ Model TabPage main grid: Column 1: Row 1 ############ -->
                        </Grid>
                        <!--END: ############ Model TabPage main grid: Column 1 ############ -->
                    </Grid>
                    <!--BEGIN: ############ Model TabPage main Grid: 2 columns 1 row ############ -->
                </TabItem>
                <!-- END: ######################################################### Model TabPage control ######################################################### -->
                <!-- BEGIN:##################################################### View & Light TabPage control ######################################################### -->
                <!-- View TabPage controls-->
                <TabItem Header="View" HorizontalAlignment="Left" Width="37">
                    <!-- BEGIN: ############ View TabPage main grid ############ -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- BEGIN: ############ View TabPage main grid: Column 0: Row 0 ############ -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="282"/>
                            </Grid.RowDefinitions>
                            <GroupBox Header="View Orientation" Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <!--- View coordinates Phi (zenith angle) -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="0">
                                        <Label Content="Phi (zenith):" Width="110"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding ViewPhiZenithAngle,Converter={StaticResource stringToDoubleConverter}, Mode=TwoWay}" Width="100" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding ViewPhiZenithAngle, Mode=TwoWay}" Minimum="{Binding XOrientationMin}" Maximum="{Binding XOrientationMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!--- View coordinates Theta (azimuth angle) -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="1">
                                        <Label Content="Theta (azimuth):" Width="110"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding ViewThetaAzimuthAngle,Converter={StaticResource stringToDoubleConverter}, Mode=TwoWay}" Width="100" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding ViewThetaAzimuthAngle, Mode=TwoWay}" Minimum="{Binding YOrientationMin}" Maximum="{Binding YOrientationMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!--- View coordinates Ro (radius distance)-->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="2">
                                        <Label Content="Ro (radius):" Width="110"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding ViewRoDistance,Converter={StaticResource stringToDoubleConverter}, Mode=TwoWay}" Width="100" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding ViewRoDistance, Mode=TwoWay}" Minimum="{Binding ViewDistanceMin}" Maximum="{Binding ViewDistanceMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <Button x:Name="btnResetOrientationToX" Grid.Row="3" Height="22" Content="Reset to Y Z" Click="btnResetViewOrientationToYZ_Click" Width="140" />
                                    <Button x:Name="btnResetOrientationToY" Grid.Row="4" Height="22" Content="Reset to Z X" Click="btnResetViewOrientationToZX_Click" Width="140" />
                                    <Button x:Name="btnResetOrientationToZ" Grid.Row="5" Height="22" Content="Reset to Y X" Click="btnResetViewOrientationToYX_Click" Width="140" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                        <!-- END: ############ View TabPage main grid: Column 0: Row 0 ############ -->
                        <!-- BEGIN: ############ View TabPage main grid: Column 1: Row 0 ############ -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="250"/>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <GroupBox Header="Light Orientation" Grid.Column="1" Grid.Row="0" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52*"/>
                                        <ColumnDefinition Width="177*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <!--- Light coordinates Phi (zenith angle) -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="0" Grid.ColumnSpan="2">
                                        <Label Content="Phi (zenith):" Width="110"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding LightPhiZenithAngle,Converter={StaticResource stringToDoubleConverter}, Mode=TwoWay}" Width="100" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding LightPhiZenithAngle, Mode=TwoWay}" Minimum="{Binding XOrientationMin}" Maximum="{Binding XOrientationMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!--- Light coordinates Theta (azimuth angle) -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="1" Grid.ColumnSpan="2">
                                        <Label Content="Theta (azimuth):" Width="110"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding LightThetaAzimuthAngle,Converter={StaticResource stringToDoubleConverter}, Mode=TwoWay}" Width="100" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding LightThetaAzimuthAngle, Mode=TwoWay}" Minimum="{Binding YOrientationMin}" Maximum="{Binding YOrientationMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <!--- Light coordinates Ro (radius distance)-->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="2" Grid.ColumnSpan="2">
                                        <Label Content="Ro (radius):" Width="110"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding LightRoDistance,Converter={StaticResource stringToDoubleConverter}, Mode=TwoWay}" Width="100" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding LightRoDistance, Mode=TwoWay}" Minimum="{Binding LightDistanceMin}" Maximum="{Binding LightDistanceMax}" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                    <CheckBox Content="Link light orientation to view" Grid.Row="3" IsChecked="{Binding LinkLightToView}" Margin="2,2,2,2" Grid.ColumnSpan="2" />
                                    <Button x:Name="btnResetLightOrientation" Grid.Row="4" Height="22" Content="Reset" Click="btnResetLightOrientation_Click" Width="140" Grid.ColumnSpan="2" Margin="44,3,45,3" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                    <!-- END: ############ View TabPage main grid ############ -->
                </TabItem>
                <!-- END :######################################################## View & Light TabPage control ######################################################### -->
                <!-- BEGIN :####################################################### Appearence TabPage control ########################################################## -->
                <!-- Appearance TabPage controls-->
                <TabItem Header="Appearance">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!--############ Column 0 Colors ############ -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="234"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <GroupBox Header="Colors" Grid.Row="0" Grid.Column="0" Margin="2,2,247,0" BorderBrush="Black" BorderThickness="1">
                                <StackPanel>
                                    <!--- View coordinates Phi (zenith angle) -->
                                    <!-- BEGIN GroupBox: color selection buttons -->
                                    <GroupBox Header="Color selection" Margin="2,0,2,0" BorderBrush="Black" BorderThickness="1" Height="154" Width="220">
                                        <StackPanel Margin="10,10,10,10" >
                                            <StackPanel Orientation="Horizontal"  Margin="8,2,2,0" >
                                                <Label Content="Shell:" Width="90" />
                                                <Button x:Name="btnMeshColor" Content="" Width="85" Height="22" Click="btnMeshColor_Click" Background="{Binding MeshColor, Converter={StaticResource colorToBrushConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="8,2,2,0" >
                                                <Label Content="Shell axis:" Width="90"/>
                                                <Button x:Name="btnAxisColor" Content="" Width="85" Height="22" Click="btnAxisColor_Click" Background="{Binding AxisColor, Converter={StaticResource colorToBrushConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"  Margin="8,2,2,0" >
                                                <Label Content="Shell spiral:" Width="90" />
                                                <Button x:Name="btnSpiralColor" Content="" Width="85" Height="22" Click="btnSpiralColor_Click" Background="{Binding SpiralColor, Converter={StaticResource colorToBrushConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"  Margin="8,2,2,0">
                                                <Label Content="Background:" Width="90" />
                                                <Button x:Name="btnBackColor" Content="" Width="85" Height="22" Click="btnBackColor_Click" Background="{Binding BackgroundColor, Converter={StaticResource colorToBrushConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <!-- END GroupBox: color selection buttons -->
                                    <!-- MeshTransparency  -->
                                    <WrapPanel Margin="2,6,2,2" Grid.Row="1">
                                        <Label Content="Transparency:"/>
                                        <TextBox TextWrapping="Wrap" Text="{Binding MeshTransparency,Converter={StaticResource doubleToIntConverter}, Mode=TwoWay}" Width="120" Style="{StaticResource VerticalCenteredTextBox}"/>
                                        <!-- binding in the controls width to take the same width than the parent Grid -->
                                        <ScrollBar Value="{Binding MeshTransparency, Mode=TwoWay, Converter={StaticResource doubleToIntConverter}}" Minimum="1" Maximum="100" Margin="2,2,0,2" Orientation="Horizontal"  Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}" SmallChange="1" LargeChange="1"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                        <!--############ Column 1 Procedural ############ -->
                        <Grid Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="250"/>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <GroupBox Header="Procedural" Grid.Row="0" Margin="247,2,2,2" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <!--- Light coordinates Phi (zenith angle) -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="0">
                                    </WrapPanel>
                                    <!--- Light coordinates Theta (azimuth angle) -->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="1">
                                    </WrapPanel>
                                    <!--- Light coordinates Ro (radius distance)-->
                                    <WrapPanel Margin="2,2,2,2" Grid.Row="2">
                                    </WrapPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- END :######################################################## Appearence TabPage control ######################################################### -->
                <!-- Section TabPage controls-->
                <TabItem Header="Section">
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>

